# Django Configuration
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL: DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Static Files & Media
DISABLE_FILE_LOGGING=False

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (uses REDIS_URL by default)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring & Error Tracking
SENTRY_DSN=
MONITORING_ENABLED=True
ENVIRONMENT=production
APP_VERSION=1.0.0

# GigaChat API Configuration (Enhanced)
# From GigaChat API documentation - get these from https://developers.sber.ru/studio

# Option 1: OAuth Credentials (Recommended)
GIGACHAT_CLIENT_ID=9314969a-854b-43ec-941b-85f1619d5196
GIGACHAT_CLIENT_SECRET=b6699e64-9988-4161-89a9-4d03f83bcca4

# Option 2: Base64 Encoded Credentials (Backward compatibility)
GIGACHAT_API_CREDENTIALS=OTMxNDk2OWEtODU0Yi00M2VjLTk0MWItODVmMTYxOWQ1MTk2OmI2Njk5ZTY0LTk5ODgtNDE2MS04OWE5LTRkMDNmODNiY2NhNA==

# GigaChat API Settings
GIGACHAT_USE_OAUTH=True
GIGACHAT_DEFAULT_MODEL=GigaChat-Max
GIGACHAT_ENABLE_AUTO_MODEL_SELECTION=True
GIGACHAT_TIMEOUT=30
GIGACHAT_MAX_RETRIES=3
GIGACHAT_MAX_TOKENS=1000
