# Available Models (comma-separated)
GIGACHAT_AVAILABLE_MODELS=GigaChat,GigaChat-Max,GigaChat-Pro

# GigaChat API Endpoints (default values from documentation)
GIGACHAT_TOKEN_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Model Selection Configuration
# Available models:
# - GigaChat: Basic model for simple tasks (lowest cost)
# - GigaChat-Max: Advanced model for complex reasoning (medium cost) - RECOMMENDED for tarot
# - GigaChat-Pro: Professional model for maximum quality (highest cost)

# Example configurations:
# For development/testing:
# GIGACHAT_DEFAULT_MODEL=GigaChat
# GIGACHAT_ENABLE_AUTO_MODEL_SELECTION=False

# For production tarot readings:
# GIGACHAT_DEFAULT_MODEL=GigaChat-Max
# GIGACHAT_ENABLE_AUTO_MODEL_SELECTION=True

# For premium readings:
# GIGACHAT_DEFAULT_MODEL=GigaChat-Pro
# GIGACHAT_ENABLE_AUTO_MODEL_SELECTION=True