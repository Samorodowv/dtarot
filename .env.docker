# Docker Environment Configuration for Tarot Project
# Copy this file to .env and customize the values

# Database Configuration
POSTGRES_PASSWORD=tarot_secure_password_change_me
DATABASE_URL=postgresql://tarot_user:tarot_secure_password_change_me@db:5432/tarot_db

# Redis Configuration  
REDIS_PASSWORD=redis_secure_password_change_me
REDIS_URL=redis://:redis_secure_password_change_me@redis:6379/0

# Django Settings
SECRET_KEY=your-very-secret-key-change-in-production-make-it-long-and-random
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,catsupremacy.ru
ENVIRONMENT=production

# API Credentials
GIGACHAT_API_CREDENTIALS=your-gigachat-api-credentials-here

# Monitoring & Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
MONITORING_ENABLED=true
APP_VERSION=1.0.0

# SSL & Security (Production)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_BROWSER_XSS_FILTER=true
SECURE_CONTENT_TYPE_NOSNIFF=true
X_FRAME_OPTIONS=DENY

# Performance Thresholds
SLOW_REQUEST_THRESHOLD=5.0
SLOW_QUERY_THRESHOLD=1.0

# Docker Build Configuration
BUILD_TARGET=production